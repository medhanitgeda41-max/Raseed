# ==============================================================================
# Raseed (رصيد) — Autonomous VAT Recovery Agent Configuration
# ==============================================================================

# LLM Mode: "demo" (Groq first) or "local" (Ollama first)
LLM_MODE=demo

# Cloud LLM API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Local LLM Endpoint (Ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Security & Governance
APP_PASSWORD=
APPROVAL_THRESHOLD_AED=10000.0

# Local Storage (Local-first, gitignored)
DATABASE_PATH=data/raseed.db
UPLOAD_DIR=data/uploads

# Persistent Cloud Memory (Cloudflare R2 + Neon Postgres)
STORAGE_BACKEND=local
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
DATABASE_URL=
SIGNUP_CODE=
